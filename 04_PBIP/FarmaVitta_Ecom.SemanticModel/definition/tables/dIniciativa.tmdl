	partition dIniciativa = m
		mode: import
		source =
				let
				    Fonte = fnCsv("01_Dados_Originais\base_complementar_ecommerce\dim_iniciativa.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"id_iniciativa", type text}, {"nome", type text}, {"pilar", type text}, {"status", type text}, {"trimestre_alvo", type text}}, "en-US"),
				    Ultimo = Tipado,
				    Final = Table.SelectColumns(Ultimo, {"id_iniciativa", "nome", "pilar", "status", "trimestre_alvo"})
				in
				    Final

	annotation PBI_ResultType = Table
