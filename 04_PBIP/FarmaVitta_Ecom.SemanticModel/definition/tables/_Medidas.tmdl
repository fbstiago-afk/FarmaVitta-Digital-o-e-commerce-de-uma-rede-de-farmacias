	/// [Clientes Digitais] no mesmo período do ano anterior (só com período comparável completo).
	measure 'Clientes Digitais LY' = IF ( [_Periodo Comparavel LY], CALCULATE ( [Clientes Digitais], SAMEPERIODLASTYEAR ( VAR _db = [_Data Base] RETURN CALCULATETABLE ( VALUES ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= _db ) ) ) ) )
		formatString: #,0
