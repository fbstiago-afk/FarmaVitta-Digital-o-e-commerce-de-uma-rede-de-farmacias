		lineageTag: ce953d54-c04d-57ea-8b40-d682b8f21161

	measure 'Cor Polaridade' = IF ( SELECTEDVALUE ( dMotivoSatisfacao[Polaridade] ) = "negativo", "#EF9277", "#18B89F" )
