	/// Cards HTML (HTML Content) com valor, comparação, cor semântica e sparkline SVG animada.
	measure 'HTML KPIs Ecom Clientes' =
			VAR _v0 = [Clientes Digitais]
			VAR _d0 = [Clientes Digitais YoY %]
			VAR _x0 = IF ( ISBLANK ( _d0 ), "sem base comparável no ano anterior", IF ( _d0 >= 0, "▲ +", "▼ −" ) & FORMAT ( ABS ( _d0 ), "0.0%", "pt-BR" ) & " vs ano anterior" )
			VAR _c0 = IF ( ISBLANK ( _d0 ), "#9FC9C1", IF ( _d0 * 1 >= 0, "#18B89F", IF ( _d0 * 1 >= -0.03, "#F2C46D", "#EF9277" ) ) )
			VAR _s0 = [_Spark Clientes Digitais]
			VAR _v1 = [Clientes Digitais Novos]
			VAR _d1 = [Txt Novos Digitais]
			VAR _x1 = IF ( ISBLANK ( _d1 ), "sem base comparável no ano anterior", _d1 )
			VAR _c1 = [Txt Neutro]
			VAR _s1 = [_Spark Clientes Digitais Novos]
			VAR _v2 = [Recompra Digital %]
			VAR _x2 = "2+ pedidos digitais no período"
			VAR _c2 = "#18B89F"
			VAR _s2 = [_Spark Recompra Digital %]
			VAR _v3 = [Frequência Digital]
			VAR _x3 = "pedidos por cliente"
			VAR _c3 = "#18B89F"
			VAR _s3 = [_Spark Frequência Digital]
