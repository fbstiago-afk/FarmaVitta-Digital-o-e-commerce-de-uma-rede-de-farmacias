		lineageTag: 32732903-d445-5b8b-aa8d-5c503d38d8bb

	measure 'Share Canal no Digital %' = DIVIDE ( [Receita Digital], CALCULATE ( [Receita Digital], ALLSELECTED ( dCanal ) ) )
		formatString: 0.0%;-0.0%;0.0%
