			    & "<div class='k' style='--c:" & _c0 & "'><div class='t'>Maturidade digital</div><div class='v'>" & IF ( ISBLANK ( _v0 ), "–", IF ( _v0 >= 1000000, FORMAT ( _v0 / 1000000, "#,0.00", "pt-BR" ) & " mi", IF ( _v0 >= 10000, FORMAT ( _v0 / 1000, "#,0.0", "pt-BR" ) & " mil", FORMAT ( _v0, "#,0", "pt-BR" ) ) ) ) & "</div><div class='d'>" & _x0 & "</div>" & "" & "</div>"
			    & "<div class='k' style='--c:" & _c1 & "'><div class='t'>Conclusão do roadmap</div><div class='v'>" & IF ( ISBLANK ( _v1 ), "–", FORMAT ( _v1, "0.0%", "pt-BR" ) ) & "</div><div class='d'>" & _x1 & "</div>" & IF ( ISBLANK ( _s1 ), "", "<svg viewBox='0 0 100 30' preserveAspectRatio='none'><polyline points='" & _s1 & "'/></svg>" ) & "</div>"
			    & "<div class='k' style='--c:" & _c2 & "'><div class='t'>Iniciativas em andamento</div><div class='v'>" & IF ( ISBLANK ( _v2 ), "–", IF ( _v2 >= 1000000, FORMAT ( _v2 / 1000000, "#,0.00", "pt-BR" ) & " mi", IF ( _v2 >= 10000, FORMAT ( _v2 / 1000, "#,0.0", "pt-BR" ) & " mil", FORMAT ( _v2, "#,0", "pt-BR" ) ) ) ) & "</div><div class='d'>" & _x2 & "</div>" & "" & "</div>"
			    & "<div class='k' style='--c:" & _c3 & "'><div class='t'>Testes A/B vencedores</div><div class='v'>" & IF ( ISBLANK ( _v3 ), "–", FORMAT ( _v3, "0.0%", "pt-BR" ) ) & "</div><div class='d'>" & _x3 & "</div>" & "" & "</div>"
			    & "<div class='k' style='--c:" & _c4 & "'><div class='t'>Lift médio (vencedores)</div><div class='v'>" & IF ( ISBLANK ( _v4 ), "–", FORMAT ( _v4, "0.0%", "pt-BR" ) ) & "</div><div class='d'>" & _x4 & "</div>" & "" & "</div>"
			    & "<div class='k' style='--c:" & _c5 & "'><div class='t'>Mídia por cliente novo</div><div class='v'>" & IF ( ISBLANK ( _v5 ), "–", "R$ " & FORMAT ( _v5, "#,0.00", "pt-BR" ) ) & "</div><div class='d'>" & _x5 & "</div>" & IF ( ISBLANK ( _s5 ), "", "<svg viewBox='0 0 100 30' preserveAspectRatio='none'><polyline points='" & _s5 & "'/></svg>" ) & "</div>"
