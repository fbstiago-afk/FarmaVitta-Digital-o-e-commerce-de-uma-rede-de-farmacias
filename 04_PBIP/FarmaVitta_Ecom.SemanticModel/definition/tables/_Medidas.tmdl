			VAR _c0 = "#18B89F"
			VAR _s0 = [_Spark Avaliações]
			VAR _v1 = [Nota Média Produto]
			VAR _d1 = [Txt Nota]
			VAR _x1 = IF ( ISBLANK ( _d1 ), "sem base comparável no ano anterior", _d1 )
			VAR _c1 = [Txt Neutro]
			VAR _s1 = [_Spark Nota Média Produto]
			VAR _v2 = [% Avaliações Abaixo de 4]
			VAR _x2 = "sinal relativo de insatisfação"
			VAR _c2 = [Txt Neutro]
			VAR _s2 = [_Spark % Avaliações Abaixo de 4]
			VAR _v3 = [Receita Digital Itens]
			VAR _x3 = "f_itens_venda · canais digitais"
			VAR _c3 = "#18B89F"
			VAR _s3 = [_Spark Receita Digital Itens]
			VAR _v4 = [Margem Digital Itens %]
			VAR _x4 = "receita − CMV de itens"
			VAR _c4 = "#18B89F"
			VAR _s4 = [_Spark Margem Digital Itens %]
			VAR _v5 = [SKUs Digitais Vendidos]
			VAR _x5 = "de 5.000 no catálogo"
			VAR _c5 = "#18B89F"
			VAR _s5 = [_Spark SKUs Digitais Vendidos]
			RETURN
			"<style>.g{display:grid;grid-template-columns:repeat(var(--n),1fr);gap:14px;font-family:Segoe UI,sans-serif;padding:2px}.k{position:relative;background:linear-gradient(160deg,rgba(255,255,255,.08),rgba(255,255,255,.02));border:1px solid rgba(24,184,159,.28);border-radius:14px;padding:12px 14px 4px 18px;overflow:hidden;animation:up .6s ease both;box-shadow:0 8px 24px rgba(0,0,0,.25)}.k:before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--c);box-shadow:0 0 12px var(--c)}.t{font-size:12px;color:#9FC9C1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:.2px}.v{font-size:25px;font-weight:600;color:#FFFFFF;margin-top:2px;white-space:nowrap}.d{font-size:11px;color:var(--c);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.k svg{width:100%;height:30px;margin-top:2px;display:block}.k polyline{fill:none;stroke:var(--c);stroke-width:2;stroke-linejoin:round;stroke-dasharray:400;stroke-dashoffset:400;animation:dr 1.6s ease forwards .3s;vector-effect:non-scaling-stroke}.k:nth-child(2){animation-delay:.08s}.k:nth-child(3){animation-delay:.16s}.k:nth-child(4){animation-delay:.24s}.k:nth-child(5){animation-delay:.32s}.k:nth-child(6){animation-delay:.4s}@keyframes up{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@keyframes dr{to{stroke-dashoffset:0}}@media (prefers-reduced-motion:reduce){.k,.k polyline{animation:none;stroke-dashoffset:0;opacity:1}}</style><div class='g' style='--n:6'>"
			    & "<div class='k' style='--c:" & _c0 & "'><div class='t'>Avaliações</div><div class='v'>" & IF ( ISBLANK ( _v0 ), "–", IF ( _v0 >= 1000000, FORMAT ( _v0 / 1000000, "#,0.00", "pt-BR" ) & " mi", IF ( _v0 >= 10000, FORMAT ( _v0 / 1000, "#,0.0", "pt-BR" ) & " mil", FORMAT ( _v0, "#,0", "pt-BR" ) ) ) ) & "</div><div class='d'>" & _x0 & "</div>" & IF ( ISBLANK ( _s0 ), "", "<svg viewBox='0 0 100 30' preserveAspectRatio='none'><polyline points='" & _s0 & "'/></svg>" ) & "</div>"
			    & "<div class='k' style='--c:" & _c1 & "'><div class='t'>Nota média</div><div class='v'>" & IF ( ISBLANK ( _v1 ), "–", FORMAT ( _v1, "#,0.00", "pt-BR" ) ) & "</div><div class='d'>" & _x1 & "</div>" & IF ( ISBLANK ( _s1 ), "", "<svg viewBox='0 0 100 30' preserveAspectRatio='none'><polyline points='" & _s1 & "'/></svg>" ) & "</div>"
			    & "<div class='k' style='--c:" & _c2 & "'><div class='t'>Avaliações abaixo de 4</div><div class='v'>" & IF ( ISBLANK ( _v2 ), "–", FORMAT ( _v2, "0.0%", "pt-BR" ) ) & "</div><div class='d'>" & _x2 & "</div>" & IF ( ISBLANK ( _s2 ), "", "<svg viewBox='0 0 100 30' preserveAspectRatio='none'><polyline points='" & _s2 & "'/></svg>" ) & "</div>"
			    & "<div class='k' style='--c:" & _c3 & "'><div class='t'>Receita digital (itens)</div><div class='v'>" & IF ( ISBLANK ( _v3 ), "–", IF ( ABS ( _v3 ) >= 1000000, "R$ " & FORMAT ( _v3 / 1000000, "#,0.00", "pt-BR" ) & " mi", "R$ " & FORMAT ( _v3 / 1000, "#,0.0", "pt-BR" ) & " mil" ) ) & "</div><div class='d'>" & _x3 & "</div>" & IF ( ISBLANK ( _s3 ), "", "<svg viewBox='0 0 100 30' preserveAspectRatio='none'><polyline points='" & _s3 & "'/></svg>" ) & "</div>"
			    & "<div class='k' style='--c:" & _c4 & "'><div class='t'>Margem digital (itens)</div><div class='v'>" & IF ( ISBLANK ( _v4 ), "–", FORMAT ( _v4, "0.0%", "pt-BR" ) ) & "</div><div class='d'>" & _x4 & "</div>" & IF ( ISBLANK ( _s4 ), "", "<svg viewBox='0 0 100 30' preserveAspectRatio='none'><polyline points='" & _s4 & "'/></svg>" ) & "</div>"
			    & "<div class='k' style='--c:" & _c5 & "'><div class='t'>SKUs vendidos no digital</div><div class='v'>" & IF ( ISBLANK ( _v5 ), "–", IF ( _v5 >= 1000000, FORMAT ( _v5 / 1000000, "#,0.00", "pt-BR" ) & " mi", IF ( _v5 >= 10000, FORMAT ( _v5 / 1000, "#,0.0", "pt-BR" ) & " mil", FORMAT ( _v5, "#,0", "pt-BR" ) ) ) ) & "</div><div class='d'>" & _x5 & "</div>" & IF ( ISBLANK ( _s5 ), "", "<svg viewBox='0 0 100 30' preserveAspectRatio='none'><polyline points='" & _s5 & "'/></svg>" ) & "</div>"
			    & "</div>"
