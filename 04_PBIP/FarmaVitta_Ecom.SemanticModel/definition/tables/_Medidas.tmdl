	measure 'Cor Resultado Digital' = VAR _v = [Margem Resultado Digital %] RETURN IF ( ISBLANK ( _v ), "#9FC9C1", IF ( _v >= 0.2, "#18B89F", IF ( _v >= 0.1, "#F2C46D", "#EF9277" ) ) )
