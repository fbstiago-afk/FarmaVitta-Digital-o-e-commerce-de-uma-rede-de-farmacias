	measure 'Cor OTIF' = VAR _v = [OTIF %] RETURN IF ( ISBLANK ( _v ), "#9FC9C1", IF ( _v >= 0.95, "#18B89F", IF ( _v >= 0.85, "#F2C46D", "#EF9277" ) ) )
		displayFolder: 10 UI & Formatação
		isHidden
