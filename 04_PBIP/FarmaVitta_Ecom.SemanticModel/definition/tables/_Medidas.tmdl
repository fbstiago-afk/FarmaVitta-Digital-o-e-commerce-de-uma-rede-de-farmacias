	measure 'Cor Conversão' = VAR _v = [Taxa Conversão %] RETURN IF ( ISBLANK ( _v ), "#9FC9C1", IF ( _v >= 0.04, "#18B89F", IF ( _v >= 0.025, "#F2C46D", "#EF9277" ) ) )
		displayFolder: 10 UI & Formatação
		isHidden
