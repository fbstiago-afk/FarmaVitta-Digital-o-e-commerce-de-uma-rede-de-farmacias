		lineageTag: 47d1ab29-b688-53dd-a82f-046a6dbd76b6

	measure Sessões = SUM ( fSessoesDigitais[sessoes] )
		formatString: #,0
		displayFolder: 03 Funil & Conversão
		lineageTag: 4ea09ca5-d0e7-51f5-8de0-1aa9afaec147

	measure Pageviews = SUM ( fSessoesDigitais[pageviews] )
		formatString: #,0
		displayFolder: 03 Funil & Conversão
		lineageTag: 1203c3ba-8805-54ac-aefd-b7294d47a9a1

	/// ATENÇÃO: menor que Checkouts na base (defeito de origem). Não usar como etapa do funil.
	measure 'Add to Cart' = SUM ( fSessoesDigitais[add_to_cart] )
		formatString: #,0
		displayFolder: 03 Funil & Conversão
		lineageTag: 732d4f38-e422-55ba-b20e-4ef42e1b426f

	measure 'Checkouts Iniciados' = SUM ( fSessoesDigitais[iniciou_checkout] )
		formatString: #,0
		displayFolder: 03 Funil & Conversão
		lineageTag: 44af857c-0dbd-590e-a516-e111ba1666d3

	/// Pedidos alocados nas sessões. Fecha com Pedidos Digitais por dia × loja × canal.
	measure 'Pedidos (Funil)' = SUM ( fSessoesDigitais[pedidos] )
		formatString: #,0
		displayFolder: 03 Funil & Conversão
		lineageTag: 092bda2f-e893-56db-baf7-019eb420ef40

	/// Pedidos ÷ sessões (f_sessoes_digitais).
	measure 'Taxa Conversão %' = DIVIDE ( [Pedidos (Funil)], [Sessões] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Funil & Conversão
		lineageTag: fd2d94c9-4b1b-5f4d-b0a3-6c159007335b

	/// Sessões com add to cart ÷ sessões. Indicador isolado (não é etapa do funil).
	measure 'Taxa Add to Cart %' = DIVIDE ( [Add to Cart], [Sessões] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Funil & Conversão
		lineageTag: 53cf2a2e-519a-528c-9fed-50d35ead8f38

	measure 'Taxa Checkout %' = DIVIDE ( [Checkouts Iniciados], [Sessões] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Funil & Conversão
		lineageTag: db48661a-656a-5525-bcd0-c20c5475fd57

	/// Pedidos ÷ checkouts iniciados.
	measure 'Checkout → Pedido %' = DIVIDE ( [Pedidos (Funil)], [Checkouts Iniciados] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Funil & Conversão
		lineageTag: 74f19c75-9613-58ad-aa1f-ee99ba2e784f

	/// Checkouts que não viraram pedido. Substitui 'abandono de carrinho', que a base não sustenta.
	measure 'Abandono Checkout %' = 1 - [Checkout → Pedido %]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Funil & Conversão
		lineageTag: 51bf497a-c10e-5fc2-9fb6-b3e3736724fd

	measure 'Pageviews por Sessão' = DIVIDE ( [Pageviews], [Sessões] )
		formatString: #,0.00
		displayFolder: 03 Funil & Conversão
		lineageTag: ac3e7e71-aba0-50a9-a316-554f9485250b

	/// Receita digital ÷ sessões. Sem filtro de dispositivo/origem (a receita não tem essas dimensões).
	measure 'Receita por Sessão' = DIVIDE ( CALCULATE ( [Receita Digital], REMOVEFILTERS ( dDispositivo ), REMOVEFILTERS ( dOrigemTrafego ) ), [Sessões] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 03 Funil & Conversão
		lineageTag: cd03a7d3-631f-5aaf-9f45-9a6ecf5b79ba

	measure 'Valor Etapa Funil' = SWITCH ( SELECTEDVALUE ( dEtapaFunil[Ordem Etapa] ), 1, [Sessões], 2, [Checkouts Iniciados], 3, [Pedidos (Funil)] )
		formatString: #,0
		displayFolder: 03 Funil & Conversão
		lineageTag: 0fa1216c-5b54-50e6-a086-dbfc345960ed

	measure 'Alerta Funil' = IF ( [Add to Cart] < [Checkouts Iniciados], "Add to cart < checkout na fonte: etapa removida do funil", "" )
		displayFolder: 03 Funil & Conversão
		lineageTag: 557f083f-1376-5cae-980a-fbf431181d9e

	measure 'Share Sessões %' = DIVIDE ( [Sessões], CALCULATE ( [Sessões], ALLSELECTED ( dDispositivo ), ALLSELECTED ( dOrigemTrafego ), ALLSELECTED ( dCanal ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Funil & Conversão
		lineageTag: 61071b25-d0d8-5c1d-adc8-33977397bc99

	measure 'Pedidos Entrega' = COUNTROWS ( fPedidosDigitais )
		formatString: #,0
		displayFolder: 04 CX
		lineageTag: 3a1052a7-39fe-5c10-8dc3-39b22a5b46ab

	/// Pedidos com prazo real ≤ prometido ÷ pedidos digitais. Não mede quantidade completa (in full): a base não tem quantidade prometida.
	measure 'OTIF %' = DIVIDE ( SUM ( fPedidosDigitais[otif] ), [Pedidos Entrega] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 CX
		lineageTag: 0da24481-e3c2-591b-ac6c-de5a594bcd7b

	measure '% Entregas com Atraso' = DIVIDE ( CALCULATE ( [Pedidos Entrega], fPedidosDigitais[Status Entrega] = "Entregue com atraso" ), [Pedidos Entrega] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 CX
		lineageTag: ad90e9a6-13fb-5050-9123-008f7de2008f

	measure '% Cancelado ou Problema' = DIVIDE ( CALCULATE ( [Pedidos Entrega], fPedidosDigitais[Status Entrega] = "Cancelado / Problema" ), [Pedidos Entrega] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 CX
		lineageTag: 271d0a20-a6cc-5ee1-9516-cb0e2b5177bc

	/// Frete médio por pedido (inclui fretes grátis = 0).
	measure 'Frete Médio' = AVERAGE ( fPedidosDigitais[frete_valor] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 04 CX
		lineageTag: beb75657-cacd-5093-b358-836f35884f67

	measure 'Frete Médio Pago' = CALCULATE ( AVERAGE ( fPedidosDigitais[frete_valor] ), fPedidosDigitais[frete_gratis] = 0 )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 04 CX
		lineageTag: b9c8c23a-3dbd-599a-b98d-57c808c100c2

	measure '% Frete Grátis' = DIVIDE ( SUM ( fPedidosDigitais[frete_gratis] ), [Pedidos Entrega] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 CX
		lineageTag: 3dda497d-b7d1-5d6b-94c4-0f1d92f3d4c1

	measure 'Prazo Prometido Médio' = AVERAGE ( fPedidosDigitais[prazo_prometido_dias] )
		formatString: #,0.0 "dias"
		displayFolder: 04 CX
		lineageTag: d20cd0a7-ca86-54f0-a4c3-91fc14b69795

	measure 'Prazo Real Médio' = AVERAGE ( fPedidosDigitais[prazo_real_dias] )
		formatString: #,0.0 "dias"
		displayFolder: 04 CX
		lineageTag: 264159a5-524c-53ab-89bd-d8db74d80f05

	/// Média de dias de atraso só entre os pedidos atrasados.
	measure 'Atraso Médio Entrega' = AVERAGEX ( FILTER ( fPedidosDigitais, fPedidosDigitais[atraso_dias] > 0 ), fPedidosDigitais[atraso_dias] )
		formatString: #,0.0 "dias"
		displayFolder: 04 CX
		lineageTag: 2bae598f-4918-5f40-ae77-d979deca50fa

	/// Soma por pedido. Difere ~6% do fulfillment mensal (fonte oficial de custo).
	measure 'Custo Fulfillment Pedidos' = SUM ( fPedidosDigitais[custo_fulfillment] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 04 CX
		lineageTag: 63135a8e-f477-5b96-a43f-63e77e8b4d58

	measure 'Respostas Pesquisa' = COUNTROWS ( fPesquisasSatisfacao )
		formatString: #,0
		displayFolder: 04 CX
		lineageTag: 5fbccf66-4beb-5e35-8f12-5c40257e8039

	measure 'Taxa de Resposta %' = DIVIDE ( [Respostas Pesquisa], [Pedidos Entrega] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 CX
		lineageTag: 91004e12-1e34-5e10-9545-2dc9806621b2

	measure Promotores = CALCULATE ( [Respostas Pesquisa], fPesquisasSatisfacao[nps_score] >= 9 )
		formatString: #,0
		displayFolder: 04 CX
		lineageTag: f128ff69-162b-5857-b766-00d223fc9397

	measure Detratores = CALCULATE ( [Respostas Pesquisa], fPesquisasSatisfacao[nps_score] <= 6 )
		formatString: #,0
		displayFolder: 04 CX
		lineageTag: df12ddd8-b3cd-5d30-9221-2020fa15973a

	measure Neutros = [Respostas Pesquisa] - [Promotores] - [Detratores]
		formatString: #,0
		displayFolder: 04 CX
		lineageTag: b71d7238-74e7-56ca-987d-ba1d24b582b9

	measure '% Promotores' = DIVIDE ( [Promotores], [Respostas Pesquisa] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 CX
		lineageTag: bd660a46-bf53-595e-a2a3-c994f3c4b1cb

	measure '% Neutros' = DIVIDE ( [Neutros], [Respostas Pesquisa] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 CX
		lineageTag: 805f7d86-5a0b-5d47-8228-8dcfa0776950

	measure '% Detratores' = DIVIDE ( [Detratores], [Respostas Pesquisa] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 CX
		lineageTag: 8c121606-a794-5ccf-b53c-a4d478dc9612

	/// % promotores (9–10) − % detratores (0–6), em pontos (−100 a +100).
	measure NPS = IF ( [Respostas Pesquisa] > 0, ( [% Promotores] - [% Detratores] ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 04 CX
		lineageTag: 9a8a4703-fb3b-53ce-875f-529caab4c2b6

	/// Média da nota CSAT (1–5).
	measure 'CSAT Médio' = AVERAGE ( fPesquisasSatisfacao[CSAT] )
		formatString: #,0.00
		displayFolder: 04 CX
		lineageTag: d1977b23-3881-53c0-bdc2-fee4dea679cc

	/// Respostas com CSAT 4 ou 5.
	measure '% CSAT Satisfeito' = DIVIDE ( CALCULATE ( [Respostas Pesquisa], fPesquisasSatisfacao[CSAT] >= 4 ), [Respostas Pesquisa] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 CX
		lineageTag: 77dd919e-46e8-534e-899b-b69525700278

	measure '% Motivo Negativo' = DIVIDE ( CALCULATE ( [Respostas Pesquisa], dMotivoSatisfacao[Polaridade] = "negativo" ), [Respostas Pesquisa] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 CX
		lineageTag: 23a0e70e-6dd5-505d-927b-be3f000676d3

	measure 'Share Respostas %' = DIVIDE ( [Respostas Pesquisa], CALCULATE ( [Respostas Pesquisa], ALLSELECTED ( dMotivoSatisfacao ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 CX
		lineageTag: aac45598-724c-578a-a214-b7cd71cdeaf2

	measure Avaliações = COUNTROWS ( fAvaliacoesProduto )
		formatString: #,0
		displayFolder: 05 Produtos Digital
		lineageTag: 49f6329c-69ae-50be-89da-11b7d853a154

	/// Média das notas 1–5. Na base só existem notas 3 e 4: use a comparação relativa.
	measure 'Nota Média Produto' = AVERAGE ( fAvaliacoesProduto[Nota] )
		formatString: #,0.00
		displayFolder: 05 Produtos Digital
		lineageTag: 2e320909-754d-57b1-a82a-9c4fe6407ad4

	/// Sinal relativo de insatisfação (única variação disponível na base).
	measure '% Avaliações Abaixo de 4' = DIVIDE ( CALCULATE ( [Avaliações], fAvaliacoesProduto[Nota] < 4 ) + 0, [Avaliações] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Produtos Digital
		lineageTag: f3b4fe6e-c947-528c-b07f-662290b89005

	measure '% Avaliações Verificadas' = DIVIDE ( CALCULATE ( [Avaliações], fAvaliacoesProduto[verificado] = 1 ), [Avaliações] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Produtos Digital
		lineageTag: dc52214a-ee8e-57d9-8cb6-94ba13f0e68a

	measure 'Share Avaliações %' = DIVIDE ( [Avaliações], CALCULATE ( [Avaliações], ALLSELECTED ( fAvaliacoesProduto[Nota] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Produtos Digital
		lineageTag: a49303ed-5bc0-5815-932e-cb1cb77c8340

	/// Receita líquida de itens nos canais digitais (f_itens_venda).
	measure 'Receita Digital Itens' = CALCULATE ( [Receita Líquida Itens], KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 05 Produtos Digital
		lineageTag: 7b99dc54-ccd4-59f3-a16d-0b406fce9a7b

	measure 'Lucro Bruto Digital Itens' = CALCULATE ( [Lucro Bruto Itens], KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 05 Produtos Digital
		lineageTag: 18b3e9e6-1370-5580-8904-4590d757f45c

	measure 'Margem Digital Itens %' = DIVIDE ( [Lucro Bruto Digital Itens], [Receita Digital Itens] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Produtos Digital
		lineageTag: 715c57f2-b952-59ee-99e5-30cc0a8c11ca

	measure 'Unidades Digitais Itens' = CALCULATE ( SUM ( fItensVenda[quantidade] ), KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ) )
		formatString: #,0
		displayFolder: 05 Produtos Digital
		lineageTag: f1a9177f-0ea7-5c79-8c2d-293471222ee9

	measure 'SKUs Digitais Vendidos' = CALCULATE ( DISTINCTCOUNT ( fItensVenda[id_produto] ), KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ) )
		formatString: #,0
		displayFolder: 05 Produtos Digital
		lineageTag: a9b75135-54a6-5ca3-b4e6-a56b3b6557dc

	measure 'Avaliações por 100 Unidades' = DIVIDE ( [Avaliações], [Unidades Digitais Itens] ) * 100
		formatString: #,0.0
		displayFolder: 05 Produtos Digital
		lineageTag: 672b997f-72a3-50b0-b4a4-57747109c5d5

	/// Unidades digitais × % de avaliações abaixo de 4 (mín. 5 avaliações). Prioriza volume com insatisfação relativa. Premissa, não causalidade.
	measure 'Score Oportunidade' = IF ( [Avaliações] >= 5, [Unidades Digitais Itens] * [% Avaliações Abaixo de 4] )
		formatString: #,0
		displayFolder: 05 Produtos Digital
		lineageTag: 48c68510-66e8-5f12-b7c0-bf42706d6a0a

	measure 'Ranking Oportunidade' = IF ( NOT ISBLANK ( [Score Oportunidade] ), RANKX ( ALLSELECTED ( dProduto ), [Score Oportunidade],, DESC, DENSE ) )
		formatString: #,0
		displayFolder: 05 Produtos Digital
		lineageTag: 94798cf0-8ad5-5731-b319-17ee5a31bfc1

	measure 'Share Receita Digital Categoria %' = DIVIDE ( [Receita Digital Itens], CALCULATE ( [Receita Digital Itens], ALLSELECTED ( dProduto ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Produtos Digital
		lineageTag: 77579329-5f76-537a-a2a7-1dfb94ebf868

	/// Clientes identificados com ao menos 1 pedido digital no período.
	measure 'Clientes Digitais' = CALCULATE ( DISTINCTCOUNT ( fVendas[id_cliente] ), KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ), fVendas[cliente_identificado] = TRUE () )
		formatString: #,0
		displayFolder: 06 Clientes Digitais
		lineageTag: d4a2fe95-381b-5f94-bf7f-da990d8b66b7

	measure 'Pedidos Digitais Identificados' = CALCULATE ( [Cupons], KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ), fVendas[cliente_identificado] = TRUE () )
		formatString: #,0
		displayFolder: 06 Clientes Digitais
		lineageTag: f12b62eb-f87f-5cd7-ad49-a7d29081b106

	measure '% Pedidos Digitais Identificados' = DIVIDE ( [Pedidos Digitais Identificados], [Pedidos Digitais] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Clientes Digitais
		lineageTag: b156281c-4f72-5aac-985a-1feced8e7aeb

	/// Clientes cuja 1ª compra digital observada (desde out/2024) caiu no período. Nos primeiros meses, quase todos aparecem como novos.
	measure 'Clientes Digitais Novos' = CALCULATE ( DISTINCTCOUNT ( fVendas[id_cliente] ), KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ), fVendas[primeira_compra_digital] = TRUE () )
		formatString: #,0
		displayFolder: 06 Clientes Digitais
		lineageTag: adc764a9-50fd-5e88-a235-01c3a428f323

	measure 'Clientes Digitais Recorrentes' = [Clientes Digitais] - [Clientes Digitais Novos]
		formatString: #,0
		displayFolder: 06 Clientes Digitais
		lineageTag: e9fe017d-bbd8-513b-a96f-c07883aa013d

	measure '% Novos Digitais' = DIVIDE ( [Clientes Digitais Novos], [Clientes Digitais] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Clientes Digitais
		lineageTag: e1c40cbc-5e1e-51ca-afa5-af2693a24d93

	/// Pedidos digitais por cliente identificado no período.
	measure 'Frequência Digital' = DIVIDE ( [Pedidos Digitais Identificados], [Clientes Digitais] )
		formatString: #,0.00
		displayFolder: 06 Clientes Digitais
		lineageTag: 3446a5a5-d8fa-5df0-a990-2b634996fb1b

	/// % dos clientes digitais com 2+ pedidos digitais no período.
	measure 'Recompra Digital %' =
			VAR _c = CALCULATETABLE ( VALUES ( fVendas[id_cliente] ), KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ), fVendas[cliente_identificado] = TRUE () )
			VAR _r = COUNTROWS ( FILTER ( _c, CALCULATE ( COUNTROWS ( fVendas ), KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ) ) >= 2 ) )
			RETURN DIVIDE ( _r, COUNTROWS ( _c ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Clientes Digitais
		lineageTag: 2b9843e2-3f8e-537e-907a-fd988dbaad10

	measure 'Ticket Digital Identificado' = CALCULATE ( [Ticket Médio], KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ), fVendas[cliente_identificado] = TRUE () )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 06 Clientes Digitais
		lineageTag: 970e9286-a855-53ac-ae03-d94fb07a7414

	measure 'Receita Digital por Cliente' = DIVIDE ( CALCULATE ( [Receita Líquida], KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ), fVendas[cliente_identificado] = TRUE () ), [Clientes Digitais] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 06 Clientes Digitais
		lineageTag: 8d8098da-51cf-592a-9587-33efacb3aa58

	/// % dos clientes digitais que também compraram na loja física no mesmo período.
	measure '% Clientes Omnichannel' =
			VAR _c = CALCULATETABLE ( VALUES ( fVendas[id_cliente] ), KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ), fVendas[cliente_identificado] = TRUE () )
			VAR _o = FILTER ( _c, CALCULATE ( COUNTROWS ( fVendas ), REMOVEFILTERS ( dCanal ), dCanal[Grupo Canal] = "Físico" ) > 0 )
			RETURN DIVIDE ( COUNTROWS ( _o ), COUNTROWS ( _c ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Clientes Digitais
		lineageTag: c8d0a8f5-3ee2-5892-8f6a-7900440e09c9

	/// Clientes cuja 1ª compra digital caiu no mês da coorte.
	measure 'Tamanho Coorte' = CALCULATE ( COUNTROWS ( dCliente ), REMOVEFILTERS ( dCalendario ), NOT ISBLANK ( dCliente[Coorte Digital Num] ) )
		formatString: #,0
		displayFolder: 06 Clientes Digitais
		lineageTag: 94538a86-1940-550a-8f16-0ee697c7eefb

	/// Clientes da coorte com pedido digital no mês ÷ tamanho da coorte. Coorte simples (1ª compra observada).
	measure 'Retenção Coorte %' = DIVIDE ( [Clientes Digitais], [Tamanho Coorte] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Clientes Digitais
		lineageTag: 5b8927d4-53b8-5de1-80c3-8654cc501105

	measure 'Share Clientes Digitais %' = DIVIDE ( [Clientes Digitais], CALCULATE ( [Clientes Digitais], ALLSELECTED ( dCliente ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Clientes Digitais
		lineageTag: 5a18618b-50fe-5f81-910b-ce1e7cb20e4a

	/// Verdadeiro quando há filtro em dimensão que não existe nos custos digitais (loja × mês): custos e resultado ficam em branco.
	measure '_Filtro Sem Custo Digital' = ISFILTERED ( dProduto ) || ISFILTERED ( dCliente ) || ISFILTERED ( dCanal[Canal] ) || ISFILTERED ( dDispositivo ) || ISFILTERED ( dOrigemTrafego ) || ISFILTERED ( dMotivoSatisfacao ) || ISFILTERED ( dFornecedor )
		displayFolder: 99 Auditoria
		isHidden
		lineageTag: 19f8129d-5636-58be-8aed-bd221ba8c7ea

	/// Mídia + plataforma + fulfillment + outros (loja × mês). Em branco com filtro de canal, produto, cliente, dispositivo ou origem.
	measure 'Custo Digital Total' = IF ( NOT [_Filtro Sem Custo Digital], SUM ( fCustosDigitais[custo_digital_total] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro Digital
		lineageTag: b1a426bb-ba44-5637-a639-03f309f0f774

	///  Em branco com filtro de canal, produto, cliente, dispositivo ou origem.
	measure 'Custo Mídia Paga' = IF ( NOT [_Filtro Sem Custo Digital], SUM ( fCustosDigitais[midia_paga] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro Digital
		lineageTag: cf7a417d-c039-5ad7-bcf6-ceabed6d4b98

	/// SaaS / gateway. Em branco com filtro de canal, produto, cliente, dispositivo ou origem.
	measure 'Custo Plataforma' = IF ( NOT [_Filtro Sem Custo Digital], SUM ( fCustosDigitais[plataforma] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro Digital
		lineageTag: 05812a01-9b0e-5d39-8b68-051186439601

	/// Fonte oficial de fulfillment (mensal). Em branco com filtro de canal, produto, cliente, dispositivo ou origem.
	measure 'Custo Fulfillment' = IF ( NOT [_Filtro Sem Custo Digital], SUM ( fCustosDigitais[fulfillment] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro Digital
		lineageTag: e2539caf-6518-5264-997c-9d3efb94daca

	///  Em branco com filtro de canal, produto, cliente, dispositivo ou origem.
	measure 'Outros Custos Digitais' = IF ( NOT [_Filtro Sem Custo Digital], SUM ( fCustosDigitais[outros_digitais] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro Digital
		lineageTag: a2b4b0f4-b676-57c1-ac2c-8b9a0266b6c0

	/// Lucro bruto digital − custos digitais diretos. Não rateia despesas da loja. NÃO é EBITDA nem lucro.
	measure 'Resultado Digital Simplificado' = IF ( NOT [_Filtro Sem Custo Digital], [Lucro Bruto Digital] - [Custo Digital Total] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro Digital
		lineageTag: 58b4818c-1ce2-52cb-9107-0844bd50e9bc

	measure 'Margem Resultado Digital %' = DIVIDE ( [Resultado Digital Simplificado], [Receita Digital] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Financeiro Digital
		lineageTag: 7ff7f97a-172c-55d4-8b54-7f902a3f801e

	measure 'Custo Digital % Receita' = DIVIDE ( [Custo Digital Total], [Receita Digital] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Financeiro Digital
		lineageTag: 2be4d764-782e-5872-b58d-b7363a7ad2f7

	measure 'Mídia % Receita Digital' = DIVIDE ( [Custo Mídia Paga], [Receita Digital] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Financeiro Digital
		lineageTag: fcb90eb2-8ef5-5309-af4f-2fcbf9cdc347

	/// Receita digital total ÷ mídia paga. Proxy: a receita não é atribuída por campanha.
	measure 'ROAS Proxy' = DIVIDE ( [Receita Digital], [Custo Mídia Paga] )
		formatString: 0.0"x"
		displayFolder: 07 Financeiro Digital
		lineageTag: 2d875240-c334-5d03-aee9-190faf0c323c

	measure 'Custo por Pedido Digital' = DIVIDE ( [Custo Digital Total], [Pedidos Digitais] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro Digital
		lineageTag: 49d343b3-d407-5ce7-978d-2a8efc4002ef

	/// Mídia paga ÷ clientes digitais novos. Proxy de CAC: sem atribuição por canal de aquisição.
	measure 'Mídia por Cliente Novo (proxy CAC)' = DIVIDE ( [Custo Mídia Paga], [Clientes Digitais Novos] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro Digital
		lineageTag: 4d1c7e89-2326-574a-95cf-5ae04e78189d

	/// [Resultado Digital Simplificado] no mesmo período do ano anterior (só com período comparável completo).
	measure 'Resultado Digital LY' = IF ( [_Periodo Comparavel LY], CALCULATE ( [Resultado Digital Simplificado], SAMEPERIODLASTYEAR ( VAR _db = [_Data Base] RETURN CALCULATETABLE ( VALUES ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= _db ) ) ) ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 01 Tempo Digital
		lineageTag: d91d3fe9-e276-5368-9ff1-113c8d960271

	measure 'Resultado Digital YoY %' = DIVIDE ( [Resultado Digital Simplificado] - [Resultado Digital LY], ABS ( [Resultado Digital LY] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Tempo Digital
		lineageTag: df89e600-57b8-52d9-8d49-e127e7b30875

	/// Último mês do roadmap dentro do filtro de datas.
	measure '_Mes Roadmap' = CALCULATE ( MAX ( fRoadmapIniciativas[data_mes] ) )
		formatString: dd/MM/yyyy
		displayFolder: 08 Estratégia
		isHidden
		lineageTag: e96e5fb3-c2bc-5844-84bc-7bb7fb2881a8

	/// Média do % de conclusão das iniciativas no último mês do período (snapshot). Nunca média de meses: o % oscila na fonte.
	measure '% Conclusão Roadmap' =
			VAR _m = [_Mes Roadmap]
			RETURN DIVIDE ( CALCULATE ( AVERAGE ( fRoadmapIniciativas[pct_conclusao] ), REMOVEFILTERS ( dCalendario ), fRoadmapIniciativas[data_mes] = _m ), 100 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Estratégia
		lineageTag: 47dddf15-b95b-5ad5-8c2a-e638cce1895d

	/// Soma do proxy de impacto no último mês. Unidade não documentada na fonte: tratar como índice relativo, não como % de receita.
	measure 'Impacto Estimado (índice)' =
			VAR _m = [_Mes Roadmap]
			RETURN CALCULATE ( SUM ( fRoadmapIniciativas[impacto_estimado_receita_pct] ), REMOVEFILTERS ( dCalendario ), fRoadmapIniciativas[data_mes] = _m )
		formatString: 0.00
		displayFolder: 08 Estratégia
		lineageTag: 9bcb771b-37ae-56b6-8c5d-82a7deb5d200

	measure Iniciativas = COUNTROWS ( dIniciativa )
		formatString: #,0
		displayFolder: 08 Estratégia
		lineageTag: 78912719-97c5-5101-aff4-9a3093fdf01b

	measure 'Iniciativas Concluídas' =
			VAR _m = [_Mes Roadmap]
			RETURN CALCULATE ( COUNTROWS ( fRoadmapIniciativas ), REMOVEFILTERS ( dCalendario ), fRoadmapIniciativas[data_mes] = _m, fRoadmapIniciativas[Status Mês] = "Concluído" ) + 0
		formatString: #,0
		displayFolder: 08 Estratégia
		lineageTag: ac6d62fb-90ad-53ff-ae2e-1f685917658b

	measure 'Iniciativas Em Andamento' =
			VAR _m = [_Mes Roadmap]
			RETURN CALCULATE ( COUNTROWS ( fRoadmapIniciativas ), REMOVEFILTERS ( dCalendario ), fRoadmapIniciativas[data_mes] = _m, fRoadmapIniciativas[Status Mês] = "Em andamento" ) + 0
		formatString: #,0
		displayFolder: 08 Estratégia
		lineageTag: 7a18e959-68a1-5d85-bd7a-e82736fe2019

	measure 'Status Roadmap Atual' =
			VAR _m = [_Mes Roadmap]
			RETURN CALCULATE ( MAX ( fRoadmapIniciativas[Status Mês] ), REMOVEFILTERS ( dCalendario ), fRoadmapIniciativas[data_mes] = _m )
		displayFolder: 08 Estratégia
		lineageTag: 40291279-cfd0-5e28-996d-6faccfd7c53c

	measure Experimentos = DISTINCTCOUNT ( fExperimentosAB[id_experimento] )
		formatString: #,0
		displayFolder: 08 Estratégia
		lineageTag: ffb1bd46-e88e-5ad3-82d8-e895d1a14edf

	measure 'Experimentos Vencedores' = CALCULATE ( DISTINCTCOUNT ( fExperimentosAB[id_experimento] ), fExperimentosAB[Resultado Teste] = "vencedor" ) + 0
		formatString: #,0
		displayFolder: 08 Estratégia
		lineageTag: ad33f5ce-8daa-53a6-93bb-9c5c93c74479

	/// Lift informado da variante B vs controle (coluna lift da fonte).
	measure 'Lift Experimento' = CALCULATE ( MAX ( fExperimentosAB[lift] ), fExperimentosAB[Resultado Teste] <> "baseline" )
		formatString: +0%;-0%;0%
		displayFolder: 08 Estratégia
		lineageTag: 1401aec3-92d7-5eed-96d2-8bab8d230274

	measure 'Lift Médio Vencedores' = CALCULATE ( AVERAGE ( fExperimentosAB[lift] ), fExperimentosAB[Resultado Teste] = "vencedor" )
		formatString: +0%;-0%;0%
		displayFolder: 08 Estratégia
		lineageTag: 85692e78-89ba-5db9-b349-bc265efc3a03

	measure 'Taxa de Vitória Testes %' = DIVIDE ( [Experimentos Vencedores], [Experimentos] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Estratégia
		lineageTag: a7bca8fc-c645-5b49-a427-c0fa0e0d0838

	measure 'Cor Resultado Teste' = SWITCH ( CALCULATE ( MAX ( fExperimentosAB[Resultado Teste] ), fExperimentosAB[Resultado Teste] <> "baseline" ), "vencedor", "#18B89F", "empatado", "#F2C46D", "#EF9277" )
		displayFolder: 08 Estratégia
		isHidden
		lineageTag: c2ba44ed-534d-50bf-962c-69ed0d7fdd83

	/// Atingimento do alvo do componente (0–100). NPS normalizado de −100..+50; CSAT de 1..4,5.
	measure 'Score Componente' = SWITCH ( SELECTEDVALUE ( dMaturidade[Ordem Componente] ), 1, MIN ( 1, DIVIDE ( [Taxa Conversão %], 0.04 ) ) * 100, 2, MIN ( 1, DIVIDE ( [OTIF %], 0.95 ) ) * 100, 3, MAX ( 0, MIN ( 1, DIVIDE ( [NPS] + 100, 150 ) ) ) * 100, 4, MAX ( 0, MIN ( 1, DIVIDE ( [CSAT Médio] - 1, 3.5 ) ) ) * 100, 5, MIN ( 1, [% Conclusão Roadmap] ) * 100 )
		formatString: 0
		displayFolder: 08 Estratégia
		lineageTag: f8f02daf-5225-5b27-9350-8142cca031d2

	measure 'Valor Componente' =
			SWITCH ( SELECTEDVALUE ( dMaturidade[Ordem Componente] ),
			    1, FORMAT ( [Taxa Conversão %], "0.00%", "pt-BR" ), 2, FORMAT ( [OTIF %], "0.0%", "pt-BR" ), 3, FORMAT ( [NPS], "+0.0;-0.0", "pt-BR" ),
			    4, FORMAT ( [CSAT Médio], "0.00", "pt-BR" ), 5, FORMAT ( [% Conclusão Roadmap], "0%", "pt-BR" ) )
		displayFolder: 08 Estratégia
		lineageTag: d0add0be-beec-5d95-b06a-47aa9c0f819b

	/// Média simples dos 5 componentes (0–100). Score de gestão com pesos iguais e alvos-premissa: não é benchmark de mercado.
	measure 'Score Maturidade Digital' = AVERAGEX ( ALL ( dMaturidade[Ordem Componente] ), [Score Componente] )
		formatString: 0
		displayFolder: 08 Estratégia
		lineageTag: d8c3afc4-1a83-5962-82f0-6b2242fac916

	measure 'Cor Score' = VAR _s = COALESCE ( [Score Componente], [Score Maturidade Digital] ) RETURN IF ( ISBLANK ( _s ), "#9FC9C1", IF ( _s >= 90, "#18B89F", IF ( _s >= 70, "#F2C46D", "#EF9277" ) ) )
		displayFolder: 08 Estratégia
		isHidden
		lineageTag: daaf4085-7807-5033-af24-7f927c25ace5

	measure 'Cor NPS' = VAR _v = [NPS] RETURN IF ( ISBLANK ( _v ), "#9FC9C1", IF ( _v >= 30, "#18B89F", IF ( _v >= 0, "#F2C46D", "#EF9277" ) ) )
		displayFolder: 10 UI & Formatação
