	/// Relativa à seleção: verde ≤ média, âmbar até 1,5× a média, coral acima.
	measure 'Cor Nota' = VAR _v = [% Avaliações Abaixo de 4] VAR _r = CALCULATE ( [% Avaliações Abaixo de 4], ALLSELECTED ( dProduto ) ) RETURN IF ( ISBLANK ( _v ), "#9FC9C1", IF ( _v <= _r, "#18B89F", IF ( _v <= _r * 1.5, "#F2C46D", "#EF9277" ) ) )
		displayFolder: 10 UI & Formatação
