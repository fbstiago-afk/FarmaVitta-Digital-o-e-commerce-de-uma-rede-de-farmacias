	/// Pontos da sparkline (viewBox 100×30) dos últimos 12 meses.
	measure '_Spark % Conclusão Roadmap' =
			VAR _fim = MIN ( CALCULATE ( MAX ( dCalendario[Data] ) ), [_Data Base] )
			VAR _ini = EDATE ( EOMONTH ( _fim, -1 ) + 1, -11 )
			VAR _t = CALCULATETABLE (
			    ADDCOLUMNS ( SUMMARIZE ( FILTER ( ALL ( dCalendario ), dCalendario[Data] >= _ini && dCalendario[Data] <= _fim ), dCalendario[AnoMes Num] ), "@v", [% Conclusão Roadmap] ),
			    REMOVEFILTERS ( dCalendario ) )
			VAR _f = FILTER ( _t, NOT ISBLANK ( [@v] ) )
			VAR _n = COUNTROWS ( _f )
			VAR _mn = MINX ( _f, [@v] )
			VAR _mx = MAXX ( _f, [@v] )
			VAR _r = ADDCOLUMNS ( _f, "@i", RANKX ( _f, dCalendario[AnoMes Num],, ASC ) )
			RETURN IF ( _n >= 2,
			    CONCATENATEX ( _r,
			        FORMAT ( ( [@i] - 1 ) / ( _n - 1 ) * 100, "0.0", "en-US" ) & "," & FORMAT ( 27 - DIVIDE ( [@v] - _mn, _mx - _mn, 0.5 ) * 22, "0.0", "en-US" ),
			        " ", dCalendario[AnoMes Num], ASC ) )
		displayFolder: 11 SVG & HTML
		isHidden
		lineageTag: 393f1f12-24d2-57b5-9383-33b9337db02d

	/// Pontos da sparkline (viewBox 100×30) dos últimos 12 meses.
	measure '_Spark Mídia por Cliente Novo (proxy CAC)' =
			VAR _fim = MIN ( CALCULATE ( MAX ( dCalendario[Data] ) ), [_Data Base] )
			VAR _ini = EDATE ( EOMONTH ( _fim, -1 ) + 1, -11 )
			VAR _t = CALCULATETABLE (
			    ADDCOLUMNS ( SUMMARIZE ( FILTER ( ALL ( dCalendario ), dCalendario[Data] >= _ini && dCalendario[Data] <= _fim ), dCalendario[AnoMes Num] ), "@v", [Mídia por Cliente Novo (proxy CAC)] ),
			    REMOVEFILTERS ( dCalendario ) )
			VAR _f = FILTER ( _t, NOT ISBLANK ( [@v] ) )
			VAR _n = COUNTROWS ( _f )
			VAR _mn = MINX ( _f, [@v] )
			VAR _mx = MAXX ( _f, [@v] )
			VAR _r = ADDCOLUMNS ( _f, "@i", RANKX ( _f, dCalendario[AnoMes Num],, ASC ) )
			RETURN IF ( _n >= 2,
			    CONCATENATEX ( _r,
			        FORMAT ( ( [@i] - 1 ) / ( _n - 1 ) * 100, "0.0", "en-US" ) & "," & FORMAT ( 27 - DIVIDE ( [@v] - _mn, _mx - _mn, 0.5 ) * 22, "0.0", "en-US" ),
			        " ", dCalendario[AnoMes Num], ASC ) )
		displayFolder: 11 SVG & HTML
		isHidden
		lineageTag: aab8c01e-79b5-54d8-a706-13e0180ba78f

	/// Cards HTML (HTML Content) com valor, comparação, cor semântica e sparkline SVG animada.
	measure 'HTML KPIs Ecom Estratégia' =
