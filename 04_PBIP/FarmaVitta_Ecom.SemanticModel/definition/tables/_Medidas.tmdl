"0.0", "en-US" ) & "%;background:#18B89F'></i></span><span class='v'>" & FORMAT ( CALCULATE ( [Pedidos Entrega], fPedidosDigitais[Status Entrega] = "Entregue no prazo" ), "#,0", "pt-BR" ) & " · " & FORMAT ( DIVIDE ( CALCULATE ( [Pedidos Entrega], fPedidosDigitais[Status Entrega] = "Entregue no prazo" ), _p ), "0.0%", "pt-BR" ) & "</span></div>" & "<div class='r'><span class='l'>Com atraso</span><span class='b'><i style='width:" & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( CALCULATE ( [Pedidos Entrega], fPedidosDigitais[Status Entrega] = "Entregue com atraso" ), _p ) ) ) * 100, "0.0", "en-US" ) & "%;background:#F2C46D'></i></span><span class='v'>" & FORMAT ( CALCULATE ( [Pedidos Entrega], fPedidosDigitais[Status Entrega] = "Entregue com atraso" ), "#,0", "pt-BR" ) & " · " & FORMAT ( DIVIDE ( CALCULATE ( [Pedidos Entrega], fPedidosDigitais[Status Entrega] = "Entregue com atraso" ), _p ), "0.0%", "pt-BR" ) & "</span></div>" & "<div class='r'><span class='l'>Cancelado/problema</span><span class='b'><i style='width:" & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( CALCULATE ( [Pedidos Entrega], fPedidosDigitais[Status Entrega] = "Cancelado / Problema" ), _p ) ) ) * 100, "0.0", "en-US" ) & "%;background:#EF9277'></i></span><span class='v'>" & FORMAT ( CALCULATE ( [Pedidos Entrega], fPedidosDigitais[Status Entrega] = "Cancelado / Problema" ), "#,0", "pt-BR" ) & " · " & FORMAT ( DIVIDE ( CALCULATE ( [Pedidos Entrega], fPedidosDigitais[Status Entrega] = "Cancelado / Problema" ), _p ), "0.0%", "pt-BR" ) & "</span></div>" & "<div class='ft'>" & "frete grátis em <b>" & FORMAT ( [% Frete Grátis], "0%", "pt-BR" ) & "</b> dos pedidos · taxa de resposta da pesquisa <b>" & FORMAT ( [Taxa de Resposta %], "0.0%", "pt-BR" ) & "</b>" & "</div></div>" )
		displayFolder: 09 Narrativas
		lineageTag: c02ec9a5-ad22-538d-ba3d-9a31b626851c

	measure 'HTML Frequência Clientes' =
			VAR _c = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( fVendas[id_cliente] ), KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ), fVendas[cliente_identificado] = TRUE () ), "@n", CALCULATE ( COUNTROWS ( fVendas ), KEEPFILTERS ( dCanal[Grupo Canal] = "Digital" ) ) )
			VAR _t = COUNTROWS ( _c )
			VAR _f0 = COUNTROWS ( FILTER ( _c, [@n] = 1 ) ) + 0
			VAR _f1 = COUNTROWS ( FILTER ( _c, [@n] >= 2 && [@n] <= 3 ) ) + 0
			VAR _f2 = COUNTROWS ( FILTER ( _c, [@n] >= 4 && [@n] <= 6 ) ) + 0
			VAR _f3 = COUNTROWS ( FILTER ( _c, [@n] >= 7 ) ) + 0
			RETURN IF ( _t = 0, "<style>.mp{font-family:Segoe UI,sans-serif;color:#E8F3F1;height:100%;box-sizing:border-box;border-top:1px solid rgba(255,255,255,.08);padding-top:10px;animation:f .6s ease both}.mp .h{font-size:12.5px;font-weight:600;color:#DDF5EB;margin-bottom:8px}.mp .r{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:11.5px}.mp .l{width:112px;color:#9FC9C1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mp .b{flex:1;height:9px;border-radius:5px;background:rgba(255,255,255,.07);overflow:hidden}.mp .b i{display:block;height:100%;border-radius:5px;animation:g 1s ease both}.mp .v{width:150px;text-align:right;white-space:nowrap}.mp .ft{font-size:10.5px;color:#9FC9C1;margin-top:8px}.mp .ft b{color:#18B89F}@keyframes g{from{width:0}}@keyframes f{from{opacity:0}to{opacity:1}}</style><div class='mp'><div class='ft'>Sem dados para os filtros selecionados.</div></div>", "<style>.mp{font-family:Segoe UI,sans-serif;color:#E8F3F1;height:100%;box-sizing:border-box;border-top:1px solid rgba(255,255,255,.08);padding-top:10px;animation:f .6s ease both}.mp .h{font-size:12.5px;font-weight:600;color:#DDF5EB;margin-bottom:8px}.mp .r{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:11.5px}.mp .l{width:112px;color:#9FC9C1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mp .b{flex:1;height:9px;border-radius:5px;background:rgba(255,255,255,.07);overflow:hidden}.mp .b i{display:block;height:100%;border-radius:5px;animation:g 1s ease both}.mp .v{width:150px;text-align:right;white-space:nowrap}.mp .ft{font-size:10.5px;color:#9FC9C1;margin-top:8px}.mp .ft b{color:#18B89F}@keyframes g{from{width:0}}@keyframes f{from{opacity:0}to{opacity:1}}</style><div class='mp'><div class='h'>Quantas vezes o cliente volta ao digital</div>" & "<div class='r'><span class='l'>1 pedido</span><span class='b'><i style='width:" & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( _f0, _t ) ) ) * 100, "0.0", "en-US" ) & "%;background:#9FC9C1'></i></span><span class='v'>" & FORMAT ( _f0, "#,0", "pt-BR" ) & " · " & FORMAT ( DIVIDE ( _f0, _t ), "0%", "pt-BR" ) & "</span></div>" & "<div class='r'><span class='l'>2 a 3 pedidos</span><span class='b'><i style='width:" & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( _f1, _t ) ) ) * 100, "0.0", "en-US" ) & "%;background:#5FA8A0'></i></span><span class='v'>" & FORMAT ( _f1, "#,0", "pt-BR" ) & " · " & FORMAT ( DIVIDE ( _f1, _t ), "0%", "pt-BR" ) & "</span></div>" & "<div class='r'><span class='l'>4 a 6 pedidos</span><span class='b'><i style='width:" & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( _f2, _t ) ) ) * 100, "0.0", "en-US" ) & "%;background:#18B89F'></i></span><span class='v'>" & FORMAT ( _f2, "#,0", "pt-BR" ) & " · " & FORMAT ( DIVIDE ( _f2, _t ), "0%", "pt-BR" ) & "</span></div>" & "<div class='r'><span class='l'>7 ou mais</span><span class='b'><i style='width:" & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( _f3, _t ) ) ) * 100, "0.0", "en-US" ) & "%;background:#DDF5EB'></i></span><span class='v'>" & FORMAT ( _f3, "#,0", "pt-BR" ) & " · " & FORMAT ( DIVIDE ( _f3, _t ), "0%", "pt-BR" ) & "</span></div>" & "<div class='ft'>" & "pedidos digitais por cliente identificado no período · base: " & FORMAT ( _t, "#,0", "pt-BR" ) & " clientes" & "</div></div>" )
		displayFolder: 09 Narrativas
		lineageTag: 0a166a49-c3d5-50bf-ab92-70c43066d812

	measure 'HTML Próximos Marcos' =
			VAR _m = [_Mes Roadmap]
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( dIniciativa[Iniciativa] ), "@p", [% Conclusão Roadmap], "@tri", CALCULATE ( MAX ( dIniciativa[Trimestre Alvo] ) ), "@pil", CALCULATE ( MAX ( dIniciativa[Pilar] ) ) ), [@p] < 1 )
			VAR _l = CONCATENATEX ( TOPN ( 5, _t, [@tri], ASC, [@p], ASC ),
			    "<div class='r'><span class='l'>" & dIniciativa[Iniciativa] & "</span><span class='b'><i style='width:" & FORMAT ( [@p] * 100, "0", "en-US" ) & "%;background:" & IF ( [@p] < 0.3, "#EF9277", IF ( [@p] < 0.7, "#F2C46D", "#18B89F" ) ) & "'></i></span><span class='v'>" & FORMAT ( [@p], "0%", "pt-BR" ) & " · alvo " & [@tri] & "</span></div>",
			    "", [@tri], ASC, [@p], ASC )
			RETURN "<style>.mp{font-family:Segoe UI,sans-serif;color:#E8F3F1;height:100%;box-sizing:border-box;border-top:1px solid rgba(255,255,255,.08);padding-top:10px;animation:f .6s ease both}.mp .h{font-size:12.5px;font-weight:600;color:#DDF5EB;margin-bottom:8px}.mp .r{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:11.5px}.mp .l{width:112px;color:#9FC9C1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mp .b{flex:1;height:9px;border-radius:5px;background:rgba(255,255,255,.07);overflow:hidden}.mp .b i{display:block;height:100%;border-radius:5px;animation:g 1s ease both}.mp .v{width:150px;text-align:right;white-space:nowrap}.mp .ft{font-size:10.5px;color:#9FC9C1;margin-top:8px}.mp .ft b{color:#18B89F}@keyframes g{from{width:0}}@keyframes f{from{opacity:0}to{opacity:1}}</style><div class='mp'><div class='h'>Próximos marcos: iniciativas abertas por prazo</div>" & IF ( COUNTROWS ( _t ) = 0, "<div class='ft'>Todas as iniciativas do filtro estão concluídas.</div>", _l )
			    & "<div class='ft'>" & FORMAT ( COUNTROWS ( _t ), "0" ) & " iniciativas abertas em " & FORMAT ( _m, "mm/yyyy" ) & " · coral &lt; 30% · âmbar &lt; 70%</div></div>"
		displayFolder: 09 Narrativas
		lineageTag: 66928813-c0eb-59fe-81b3-f249415caf79

	measure 'HTML Experimentos' =
			VAR _t = SUMMARIZE ( FILTER ( fExperimentosAB, fExperimentosAB[Resultado Teste] <> "baseline" ), fExperimentosAB[Experimento], fExperimentosAB[Métrica Teste], fExperimentosAB[Resultado Teste], fExperimentosAB[lift] )
			VAR _mx = MAXX ( _t, fExperimentosAB[lift] )
			VAR _l = CONCATENATEX ( _t,
			    "<div class='r'><span class='l'>" & fExperimentosAB[Experimento] & "</span><span class='b'><i style='width:" & FORMAT ( DIVIDE ( fExperimentosAB[lift], _mx ) * 100, "0", "en-US" ) & "%;background:" & IF ( fExperimentosAB[Resultado Teste] = "vencedor", "#18B89F", "#F2C46D" ) & "'></i></span><span class='v'>" & FORMAT ( fExperimentosAB[lift], "+0%", "pt-BR" ) & " · " & SUBSTITUTE ( fExperimentosAB[Métrica Teste], "_", " " ) & "</span></div>",
			    "", fExperimentosAB[lift], DESC )
			RETURN "<style>.mp{font-family:Segoe UI,sans-serif;color:#E8F3F1;height:100%;box-sizing:border-box;border-top:1px solid rgba(255,255,255,.08);padding-top:10px;animation:f .6s ease both}.mp .h{font-size:12.5px;font-weight:600;color:#DDF5EB;margin-bottom:8px}.mp .r{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:11.5px}.mp .l{width:112px;color:#9FC9C1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mp .b{flex:1;height:9px;border-radius:5px;background:rgba(255,255,255,.07);overflow:hidden}.mp .b i{display:block;height:100%;border-radius:5px;animation:g 1s ease both}.mp .v{width:150px;text-align:right;white-space:nowrap}.mp .ft{font-size:10.5px;color:#9FC9C1;margin-top:8px}.mp .ft b{color:#18B89F}@keyframes g{from{width:0}}@keyframes f{from{opacity:0}to{opacity:1}}</style><div class='mp'><div class='h'>Testes A/B: lift da variante B por métrica</div>" & _l & "<div class='ft'>turquesa = venceu · âmbar = empatou · cada lift mede uma métrica diferente</div></div>"
		displayFolder: 09 Narrativas
		lineageTag: d55aaafc-1efa-5361-993a-a5ee72e16c0a

	/// Barra SVG relativa ao maior canal × loja da seleção.
	measure 'SVG Barra Receita Canal Loja' =
			VAR _v = [Receita Digital]
			VAR _mx = MAXX ( CROSSJOIN ( ALLSELECTED ( dCanal[Canal] ), ALLSELECTED ( dLoja[Loja Curta] ) ), CALCULATE ( [Receita Digital] ) )
			VAR _w = IF ( _mx > 0, MAX ( 2, DIVIDE ( _v, _mx ) * 116 ), 0 )
			RETURN IF ( NOT ISBLANK ( _v ),
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='18'><rect x='0' y='5' width='120' height='8' rx='4' fill='%23FFFFFF' fill-opacity='0.08'/><rect x='0' y='5' width='" & FORMAT ( _w, "0", "en-US" ) & "' height='8' rx='4' fill='%2318B89F'/></svg>" )
		dataCategory: ImageUrl
		displayFolder: 11 SVG & HTML
		lineageTag: 7bc9e3a5-ecc4-59aa-9abf-87ccb919af0f

	column '_'
		dataType: string
		isHidden
		lineageTag: acd47bbe-02f5-563e-966a-1c91129aebe3
		summarizeBy: none
		sourceColumn: _

		annotation SummarizationSetBy = Automatic

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = #table(type table [_ = text], {})
				in
				    Fonte

	annotation PBI_ResultType = Table
