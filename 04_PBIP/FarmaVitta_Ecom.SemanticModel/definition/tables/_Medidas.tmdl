	/// [Receita Digital] no mesmo período do ano anterior (só com período comparável completo).
	measure 'Receita Digital LY' = IF ( [_Periodo Comparavel LY], CALCULATE ( [Receita Digital], SAMEPERIODLASTYEAR ( VAR _db = [_Data Base] RETURN CALCULATETABLE ( VALUES ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= _db ) ) ) ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
