	measure 'HTML Alerta Funil' = "<style>.a{font-family:Segoe UI,sans-serif;color:#E8F3F1;background:rgba(242,196,109,.10);border:1px solid rgba(242,196,109,.5);border-radius:12px;padding:10px 14px;height:100%;box-sizing:border-box}.a b{color:#F2C46D}.a p{margin:4px 0 0;font-size:11.5px;line-height:1.45}</style><div class='a'><b>⚠ Qualidade da base</b><p>Add to cart (" & FORMAT ( [Add to Cart], "#,0", "pt-BR" ) & ") é menor que checkouts (" & FORMAT ( [Checkouts Iniciados], "#,0", "pt-BR" ) & ") em todos os meses. O funil usa Sessões → Checkout → Pedido; add to cart aparece só como taxa isolada.</p></div>"
		displayFolder: 09 Narrativas
		lineageTag: 3f1e9b99-95c3-5c33-b33a-b0591a92f91e

	measure 'HTML Alerta Reviews' = "<style>.a{font-family:Segoe UI,sans-serif;color:#E8F3F1;background:rgba(242,196,109,.10);border:1px solid rgba(242,196,109,.5);border-radius:12px;padding:10px 14px;height:100%;box-sizing:border-box}.a b{color:#F2C46D}.a p{margin:4px 0 0;font-size:11.5px;line-height:1.45}</style><div class='a'><b>⚠ Qualidade da base</b><p>As avaliações só têm notas 3 e 4. A nota média quase não varia; use o % abaixo de 4 como sinal relativo. Não há base para afirmar baixa satisfação absoluta.</p></div>"
		displayFolder: 09 Narrativas
		lineageTag: 52fbb82f-7efc-5241-9e24-411aa78b8b71

	measure 'HTML Tooltip Digital' =
			VAR _r = [Receita Digital]
			VAR _y = [Receita Digital YoY %]
			VAR _c = IF ( ISBLANK ( _y ), "#9FC9C1", IF ( _y >= 0, "#18B89F", "#EF9277" ) )
			RETURN "<style>.tt{font-family:Segoe UI,sans-serif;color:#E8F3F1;padding:4px}.tt .l{font-size:11px;color:#9FC9C1}.tt .b{font-size:22px;font-weight:600}.tt .r{display:flex;gap:16px;margin-top:8px}.tt .s{font-size:10px;color:#9FC9C1;margin-top:10px;border-top:1px solid rgba(255,255,255,.1);padding-top:6px;line-height:1.4}</style>"
			    & "<div class='tt'><div class='l'>Receita digital · " & [Período Selecionado] & "</div><div class='b'>" & IF ( ABS ( _r ) >= 1000000, "R$ " & FORMAT ( _r / 1000000, "#,0.00", "pt-BR" ) & " mi", "R$ " & FORMAT ( _r / 1000, "#,0.0", "pt-BR" ) & " mil" ) & " <span style='font-size:13px;color:" & _c & "'>" & IF ( ISBLANK ( _y ), "s/ base LY", FORMAT ( _y, "+0.0%;-0.0%", "pt-BR" ) & " vs LY" ) & "</span></div>"
			    & "<div class='r'><div><div class='l'>Pedidos</div><b>" & FORMAT ( [Pedidos Digitais], "#,0", "pt-BR" ) & "</b></div>"
			    & "<div><div class='l'>Ticket</div><b>R$ " & FORMAT ( [Ticket Médio Digital], "#,0.00", "pt-BR" ) & "</b></div>"
			    & "<div><div class='l'>OTIF</div><b>" & FORMAT ( [OTIF %], "0.0%", "pt-BR" ) & "</b></div>"
			    & "<div><div class='l'>NPS</div><b>" & FORMAT ( [NPS], "+0;-0", "pt-BR" ) & "</b></div></div>"
			    & "<div class='s'>Receita digital = f_vendas nos canais Site, App e Delivery. "
			    & IF ( [OTIF %] < 0.95, "Insight: OTIF abaixo do alvo de 95% — checar prazo prometido.", "Insight: OTIF no alvo." ) & "</div></div>"
		displayFolder: 11 SVG & HTML
		lineageTag: 386da253-f2f8-55f6-9b79-ebdd51c2a7a5

	measure 'HTML Chips Filtros Digital' =
			VAR _c = IF ( ISFILTERED ( dCalendario[Ano] ), "<span class='c'><b>Ano</b> " & IF ( COUNTROWS ( VALUES ( dCalendario[Ano] ) ) > 3, FORMAT ( COUNTROWS ( VALUES ( dCalendario[Ano] ) ), "0" ) & " itens", CONCATENATEX ( VALUES ( dCalendario[Ano] ), dCalendario[Ano], ", " ) ) & "</span>" )
			    & IF ( ISFILTERED ( dCalendario[Mes Nome] ), "<span class='c'><b>Mês</b> " & IF ( COUNTROWS ( VALUES ( dCalendario[Mes Nome] ) ) > 3, FORMAT ( COUNTROWS ( VALUES ( dCalendario[Mes Nome] ) ), "0" ) & " itens", CONCATENATEX ( VALUES ( dCalendario[Mes Nome] ), dCalendario[Mes Nome], ", " ) ) & "</span>" )
			    & IF ( ISFILTERED ( dLoja[Loja] ), "<span class='c'><b>Loja</b> " & IF ( COUNTROWS ( VALUES ( dLoja[Loja] ) ) > 3, FORMAT ( COUNTROWS ( VALUES ( dLoja[Loja] ) ), "0" ) & " itens", CONCATENATEX ( VALUES ( dLoja[Loja] ), dLoja[Loja], ", " ) ) & "</span>" )
			    & IF ( ISFILTERED ( dCanal[Canal] ), "<span class='c'><b>Canal</b> " & IF ( COUNTROWS ( VALUES ( dCanal[Canal] ) ) > 3, FORMAT ( COUNTROWS ( VALUES ( dCanal[Canal] ) ), "0" ) & " itens", CONCATENATEX ( VALUES ( dCanal[Canal] ), dCanal[Canal], ", " ) ) & "</span>" )
			    & IF ( ISFILTERED ( dDispositivo[Dispositivo] ), "<span class='c'><b>Dispositivo</b> " & IF ( COUNTROWS ( VALUES ( dDispositivo[Dispositivo] ) ) > 3, FORMAT ( COUNTROWS ( VALUES ( dDispositivo[Dispositivo] ) ), "0" ) & " itens", CONCATENATEX ( VALUES ( dDispositivo[Dispositivo] ), dDispositivo[Dispositivo], ", " ) ) & "</span>" )
			    & IF ( ISFILTERED ( dOrigemTrafego[Grupo Origem] ), "<span class='c'><b>Origem</b> " & IF ( COUNTROWS ( VALUES ( dOrigemTrafego[Grupo Origem] ) ) > 3, FORMAT ( COUNTROWS ( VALUES ( dOrigemTrafego[Grupo Origem] ) ), "0" ) & " itens", CONCATENATEX ( VALUES ( dOrigemTrafego[Grupo Origem] ), dOrigemTrafego[Grupo Origem], ", " ) ) & "</span>" )
			    & IF ( ISFILTERED ( dProduto[Categoria] ), "<span class='c'><b>Categoria</b> " & IF ( COUNTROWS ( VALUES ( dProduto[Categoria] ) ) > 3, FORMAT ( COUNTROWS ( VALUES ( dProduto[Categoria] ) ), "0" ) & " itens", CONCATENATEX ( VALUES ( dProduto[Categoria] ), dProduto[Categoria], ", " ) ) & "</span>" )
			    & IF ( ISFILTERED ( dCliente[Segmento RFV] ), "<span class='c'><b>RFV</b> " & IF ( COUNTROWS ( VALUES ( dCliente[Segmento RFV] ) ) > 3, FORMAT ( COUNTROWS ( VALUES ( dCliente[Segmento RFV] ) ), "0" ) & " itens", CONCATENATEX ( VALUES ( dCliente[Segmento RFV] ), dCliente[Segmento RFV], ", " ) ) & "</span>" )
			    & IF ( ISFILTERED ( dIniciativa[Pilar] ), "<span class='c'><b>Pilar</b> " & IF ( COUNTROWS ( VALUES ( dIniciativa[Pilar] ) ) > 3, FORMAT ( COUNTROWS ( VALUES ( dIniciativa[Pilar] ) ), "0" ) & " itens", CONCATENATEX ( VALUES ( dIniciativa[Pilar] ), dIniciativa[Pilar], ", " ) ) & "</span>" )
			RETURN "<style>.w{font-family:Segoe UI,sans-serif;display:flex;flex-wrap:wrap;gap:6px;align-items:center;height:100%}.c{background:rgba(24,184,159,.16);border:1px solid rgba(24,184,159,.45);color:#DDF5EB;border-radius:20px;padding:3px 10px;font-size:11px;animation:f .4s ease both}.c b{color:#18B89F;font-weight:600;margin-right:3px}.z{color:#9FC9C1;font-size:11px}@keyframes f{from{opacity:0}to{opacity:1}}</style><div class='w'>" & IF ( _c = "", "<span class='z'>Canais digitais (Site · App · Delivery) · período completo 01/10/2024 a 30/09/2026</span>", _c ) & "</div>"
		displayFolder: 11 SVG & HTML
		lineageTag: 72665fe6-4f1c-5572-a990-5d655c0c26dc

	/// Pontos da sparkline (viewBox 100×30) dos últimos 12 meses.
	measure '_Spark Receita Digital' =
			VAR _fim = MIN ( CALCULATE ( MAX ( dCalendario[Data] ) ), [_Data Base] )
			VAR _ini = EDATE ( EOMONTH ( _fim, -1 ) + 1, -11 )
			VAR _t = CALCULATETABLE (
			    ADDCOLUMNS ( SUMMARIZE ( FILTER ( ALL ( dCalendario ), dCalendario[Data] >= _ini && dCalendario[Data] <= _fim ), dCalendario[AnoMes Num] ), "@v", [Receita Digital] ),
			    REMOVEFILTERS ( dCalendario ) )
			VAR _f = FILTER ( _t, NOT ISBLANK ( [@v] ) )
			VAR _n = COUNTROWS ( _f )
			VAR _mn = MINX ( _f, [@v] )
			VAR _mx = MAXX ( _f, [@v] )
			VAR _r = ADDCOLUMNS ( _f, "@i", RANKX ( _f, dCalendario[AnoMes Num],, ASC ) )
			RETURN IF ( _n >= 2,
			    CONCATENATEX ( _r,
			        FORMAT ( ( [@i] - 1 ) / ( _n - 1 ) * 100, "0.0", "en-US" ) & "," & FORMAT ( 27 - DIVIDE ( [@v] - _mn, _mx - _mn, 0.5 ) * 22, "0.0", "en-US" ),
			        " ", dCalendario[AnoMes Num], ASC ) )
		displayFolder: 11 SVG & HTML
		isHidden
		lineageTag: 5dd71766-9374-5ded-8e26-6b83ef82f1b2

	/// Pontos da sparkline (viewBox 100×30) dos últimos 12 meses.
	measure '_Spark Share Digital %' =
			VAR _fim = MIN ( CALCULATE ( MAX ( dCalendario[Data] ) ), [_Data Base] )
			VAR _ini = EDATE ( EOMONTH ( _fim, -1 ) + 1, -11 )
			VAR _t = CALCULATETABLE (
			    ADDCOLUMNS ( SUMMARIZE ( FILTER ( ALL ( dCalendario ), dCalendario[Data] >= _ini && dCalendario[Data] <= _fim ), dCalendario[AnoMes Num] ), "@v", [Share Digital %] ),
			    REMOVEFILTERS ( dCalendario ) )
			VAR _f = FILTER ( _t, NOT ISBLANK ( [@v] ) )
			VAR _n = COUNTROWS ( _f )
			VAR _mn = MINX ( _f, [@v] )
			VAR _mx = MAXX ( _f, [@v] )
			VAR _r = ADDCOLUMNS ( _f, "@i", RANKX ( _f, dCalendario[AnoMes Num],, ASC ) )
			RETURN IF ( _n >= 2,
			    CONCATENATEX ( _r,
			        FORMAT ( ( [@i] - 1 ) / ( _n - 1 ) * 100, "0.0", "en-US" ) & "," & FORMAT ( 27 - DIVIDE ( [@v] - _mn, _mx - _mn, 0.5 ) * 22, "0.0", "en-US" ),
			        " ", dCalendario[AnoMes Num], ASC ) )
