	measure 'HTML Custos Digitais' =
			VAR _t = [Custo Digital Total]
			VAR _r = [Receita Digital]
			RETURN IF ( ISBLANK ( _t ), "<style>.mp{font-family:Segoe UI,sans-serif;color:#E8F3F1;height:100%;box-sizing:border-box;border-top:1px solid rgba(255,255,255,.08);padding-top:10px;animation:f .6s ease both}.mp .h{font-size:12.5px;font-weight:600;color:#DDF5EB;margin-bottom:8px}.mp .r{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:11.5px}.mp .l{width:112px;color:#9FC9C1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mp .b{flex:1;height:9px;border-radius:5px;background:rgba(255,255,255,.07);overflow:hidden}.mp .b i{display:block;height:100%;border-radius:5px;animation:g 1s ease both}.mp .v{width:150px;text-align:right;white-space:nowrap}.mp .ft{font-size:10.5px;color:#9FC9C1;margin-top:8px}.mp .ft b{color:#18B89F}@keyframes g{from{width:0}}@keyframes f{from{opacity:0}to{opacity:1}}</style><div class='mp'><div class='ft'>Custos digitais são por loja × mês: indisponíveis com filtro de canal, produto ou cliente.</div></div>", "<style>.mp{font-family:Segoe UI,sans-serif;color:#E8F3F1;height:100%;box-sizing:border-box;border-top:1px solid rgba(255,255,255,.08);padding-top:10px;animation:f .6s ease both}.mp .h{font-size:12.5px;font-weight:600;color:#DDF5EB;margin-bottom:8px}.mp .r{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:11.5px}.mp .l{width:112px;color:#9FC9C1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mp .b{flex:1;height:9px;border-radius:5px;background:rgba(255,255,255,.07);overflow:hidden}.mp .b i{display:block;height:100%;border-radius:5px;animation:g 1s ease both}.mp .v{width:150px;text-align:right;white-space:nowrap}.mp .ft{font-size:10.5px;color:#9FC9C1;margin-top:8px}.mp .ft b{color:#18B89F}@keyframes g{from{width:0}}@keyframes f{from{opacity:0}to{opacity:1}}</style><div class='mp'><div class='h'>Para onde vai o custo digital</div>" & "<div class='r'><span class='l'>Mídia paga</span><span class='b'><i style='width:" & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [Custo Mídia Paga], _t ) ) ) * 100, "0.0", "en-US" ) & "%;background:#EF9277'></i></span><span class='v'>" & "R$ " & FORMAT ( [Custo Mídia Paga] / 1000, "#,0", "pt-BR" ) & " mil" & " · " & FORMAT ( DIVIDE ( [Custo Mídia Paga], _r ), "0.0%", "pt-BR" ) & "</span></div>" & "<div class='r'><span class='l'>Fulfillment</span><span class='b'><i style='width:" & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [Custo Fulfillment], _t ) ) ) * 100, "0.0", "en-US" ) & "%;background:#F2C46D'></i></span><span class='v'>" & "R$ " & FORMAT ( [Custo Fulfillment] / 1000, "#,0", "pt-BR" ) & " mil" & " · " & FORMAT ( DIVIDE ( [Custo Fulfillment], _r ), "0.0%", "pt-BR" ) & "</span></div>" & "<div class='r'><span class='l'>Plataforma</span><span class='b'><i style='width:" & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [Custo Plataforma], _t ) ) ) * 100, "0.0", "en-US" ) & "%;background:#DDF5EB'></i></span><span class='v'>" & "R$ " & FORMAT ( [Custo Plataforma] / 1000, "#,0", "pt-BR" ) & " mil" & " · " & FORMAT ( DIVIDE ( [Custo Plataforma], _r ), "0.0%", "pt-BR" ) & "</span></div>" & "<div class='r'><span class='l'>Outros</span><span class='b'><i style='width:" & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [Outros Custos Digitais], _t ) ) ) * 100, "0.0", "en-US" ) & "%;background:#5FA8A0'></i></span><span class='v'>" & "R$ " & FORMAT ( [Outros Custos Digitais] / 1000, "#,0", "pt-BR" ) & " mil" & " · " & FORMAT ( DIVIDE ( [Outros Custos Digitais], _r ), "0.0%", "pt-BR" ) & "</span></div>" & "<div class='ft'>" & "ROAS proxy <b>" & FORMAT ( [ROAS Proxy], "0.0", "pt-BR" ) & "x</b> · custo por pedido <b>R$ " & FORMAT ( [Custo por Pedido Digital], "#,0.00", "pt-BR" ) & "</b> · valor · % da receita digital" & "</div></div>" )
		displayFolder: 09 Narrativas
		lineageTag: 84588aff-5c4b-5776-ad60-9c7041b56b11

	measure 'HTML Status Entrega' =
			VAR _p = [Pedidos Entrega]
