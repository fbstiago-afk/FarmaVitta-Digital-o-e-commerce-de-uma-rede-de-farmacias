	measure 'Cor CSAT' = VAR _v = [CSAT Médio] RETURN IF ( ISBLANK ( _v ), "#9FC9C1", IF ( _v >= 4.5, "#18B89F", IF ( _v >= 4, "#F2C46D", "#EF9277" ) ) )
		displayFolder: 10 UI & Formatação
		isHidden
