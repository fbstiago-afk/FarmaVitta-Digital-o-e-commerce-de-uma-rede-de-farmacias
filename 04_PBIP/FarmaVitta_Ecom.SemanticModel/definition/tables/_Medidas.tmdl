			    & "<div class='k' style='--c:" & _c0 & "'><div class='t'>Clientes digitais</div><div class='v'>" & IF ( ISBLANK ( _v0 ), "–", IF ( _v0 >= 1000000, FORMAT ( _v0 / 1000000, "#,0.00", "pt-BR" ) & " mi", IF ( _v0 >= 10000, FORMAT ( _v0 / 1000, "#,0.0", "pt-BR" ) & " mil", FORMAT ( _v0, "#,0", "pt-BR" ) ) ) ) & "</div><div class='d'>" & _x0 & "</div>" & IF ( ISBLANK ( _s0 ), "", "<svg viewBox='0 0 100 30' preserveAspectRatio='none'><polyline points='" & _s0 & "'/></svg>" ) & "</div>"
