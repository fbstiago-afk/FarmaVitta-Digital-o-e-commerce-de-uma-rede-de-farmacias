		lineageTag: 42e03aef-48fe-586e-b745-86405897cc3c

	/// Receita digital / receita líquida da rede no mesmo filtro de loja, data e produto.
	measure 'Share Digital %' = DIVIDE ( [Receita Digital], [Receita Rede (todos os canais)] )
		formatString: 0.0%;-0.0%;0.0%
