/// Reviews de produto (1 por cliente × produto, amostra). ATENÇÃO: a base só tem notas 3 e 4 (ver GATE A). Loja herdada do cupom.
table fAvaliacoesProduto
	lineageTag: 2f528bf9-d24a-55b2-bf94-477de519dad7

	column id_avaliacao
		dataType: string
		isHidden
		lineageTag: ff3b370f-fd06-5a5a-927b-f4d46df86bbc
