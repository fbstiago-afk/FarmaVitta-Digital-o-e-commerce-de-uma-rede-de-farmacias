	partition fAvaliacoesProduto = m
		mode: import
		source =
				let
				    Fonte = fnCsv("01_Dados_Originais\base_complementar_ecommerce\f_avaliacoes_produto.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"id_avaliacao", type text}, {"id_cliente", type text}, {"id_produto", type text}, {"id_venda", type text}, {"data_avaliacao", type date}, {"nota", Int64.Type}, {"comentario_curto", type text}, {"verificado", Int64.Type}, {"canal_avaliacao", type text}}, "en-US"),
				    Cupom = Table.Buffer(Table.SelectColumns(fnCsv("01_Dados_Originais\base_original\f_vendas.csv"), {"id_venda", "id_loja"})),
				    J = Table.NestedJoin(Tipado, "id_venda", Cupom, "id_venda", "v", JoinKind.LeftOuter),
				    E = Table.ExpandTableColumn(J, "v", {"id_loja"}),
				    Ultimo = E,
				    Final = Table.SelectColumns(Ultimo, {"id_avaliacao", "id_cliente", "id_produto", "id_venda", "data_avaliacao", "nota", "comentario_curto", "verificado", "canal_avaliacao", "id_loja"})
				in
				    Final

	annotation PBI_ResultType = Table
