				    Fonte = fnCsv("01_Dados_Originais\base_complementar_ecommerce\f_experimentos_ab.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"id_experimento", type text}, {"nome_experimento", type text}, {"variante", type text}, {"data_inicio", type date}, {"data_fim", type date}, {"metrica", type text}, {"valor", type number}, {"lift", type number}, {"resultado", type text}}, "en-US"),
