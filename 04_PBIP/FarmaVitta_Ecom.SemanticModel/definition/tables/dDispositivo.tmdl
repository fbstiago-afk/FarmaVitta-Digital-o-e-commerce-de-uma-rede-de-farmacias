	partition dDispositivo = m
		mode: import
		source =
				let
				    Fonte = fnCsv("01_Dados_Originais\base_complementar_ecommerce\dim_dispositivo.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"id_dispositivo", type text}, {"nome", type text}, {"tipo", type text}, {"ordem", Int64.Type}}, "en-US"),
				    Ultimo = Tipado,
				    Final = Table.SelectColumns(Ultimo, {"id_dispositivo", "nome", "tipo", "ordem"})
				in
				    Final

	annotation PBI_ResultType = Table
