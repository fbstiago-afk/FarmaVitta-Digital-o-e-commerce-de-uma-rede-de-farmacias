/// Dispositivos de acesso (4).
table dDispositivo
	lineageTag: 3927f6c4-72ca-520f-9bbe-2d8f7136762a

	column id_dispositivo
		dataType: string
		isHidden
		lineageTag: 059bafff-7412-5394-abee-e344bdb81557
		summarizeBy: none
		sourceColumn: id_dispositivo

		annotation SummarizationSetBy = Automatic

	column Dispositivo
		dataType: string
