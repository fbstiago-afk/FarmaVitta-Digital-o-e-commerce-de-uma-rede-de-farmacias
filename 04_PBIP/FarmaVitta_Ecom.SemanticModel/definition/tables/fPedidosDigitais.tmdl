	column id_cliente
		dataType: string
		isHidden
		lineageTag: 7872c162-9402-5650-ac8d-ae84aaa156d6
		summarizeBy: none
		sourceColumn: id_cliente

		annotation SummarizationSetBy = Automatic

	column atraso_dias
		dataType: int64
		isHidden
		lineageTag: 82465154-12ce-5cdd-ab36-94fafa406d0a
		summarizeBy: none
		sourceColumn: atraso_dias

		annotation SummarizationSetBy = Automatic

	column frete_gratis
		dataType: int64
		isHidden
		lineageTag: 04f17649-aac7-5504-9738-db40053a78c6
		summarizeBy: none
		sourceColumn: frete_gratis

		annotation SummarizationSetBy = Automatic

	partition fPedidosDigitais = m
		mode: import
		source =
				let
				    Fonte = fnCsv("01_Dados_Originais\base_complementar_ecommerce\f_pedidos_digitais.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"id_venda", type text}, {"data_venda", type date}, {"id_loja", type text}, {"canal", type text}, {"frete_valor", type number}, {"prazo_prometido_dias", Int64.Type}, {"prazo_real_dias", Int64.Type}, {"status_entrega", type text}, {"custo_fulfillment", type number}, {"otif", Int64.Type}}, "en-US"),
				    Cupom = Table.Buffer(Table.SelectColumns(fnCsv("01_Dados_Originais\base_original\f_vendas.csv"), {"id_venda", "id_cliente"})),
				    J = Table.NestedJoin(Tipado, "id_venda", Cupom, "id_venda", "v", JoinKind.LeftOuter),
				    E = Table.ExpandTableColumn(J, "v", {"id_cliente"}),
				    Anon = Table.ReplaceValue(E, "", "NI", Replacer.ReplaceValue, {"id_cliente"}),
				    Atraso = Table.AddColumn(Anon, "atraso_dias", each List.Max({0, [prazo_real_dias] - [prazo_prometido_dias]}), Int64.Type),
				    Gratis = Table.AddColumn(Atraso, "frete_gratis", each if [frete_valor] = 0 then 1 else 0, Int64.Type),
				    Ultimo = Gratis,
				    Final = Table.SelectColumns(Ultimo, {"id_venda", "data_venda", "id_loja", "canal", "frete_valor", "prazo_prometido_dias", "prazo_real_dias", "status_entrega", "custo_fulfillment", "otif", "id_cliente", "atraso_dias", "frete_gratis"})
				in
				    Final

	annotation PBI_ResultType = Table
