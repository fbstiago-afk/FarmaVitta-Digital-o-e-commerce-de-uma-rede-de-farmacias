				    Tipado = Table.TransformColumnTypes(Fonte, {{"data", type date}, {"id_loja", type text}, {"canal", type text}, {"id_dispositivo", type text}, {"id_origem", type text}, {"sessoes", Int64.Type}, {"pageviews", Int64.Type}, {"add_to_cart", Int64.Type}, {"iniciou_checkout", Int64.Type}, {"pedidos", Int64.Type}}, "en-US"),
				    Ultimo = Tipado,
				    Final = Table.SelectColumns(Ultimo, {"data", "id_loja", "canal", "id_dispositivo", "id_origem", "sessoes", "pageviews", "add_to_cart", "iniciou_checkout", "pedidos"})
				in
