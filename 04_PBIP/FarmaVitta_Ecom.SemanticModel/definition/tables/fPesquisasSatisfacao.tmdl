	partition fPesquisasSatisfacao = m
		mode: import
		source =
				let
				    Fonte = fnCsv("01_Dados_Originais\base_complementar_ecommerce\f_pesquisas_satisfacao.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"id_pesquisa", type text}, {"id_cliente", type text}, {"id_venda", type text}, {"data_pesquisa", type date}, {"canal", type text}, {"id_loja", type text}, {"nps_score", Int64.Type}, {"csat_score", Int64.Type}, {"id_motivo_principal", type text}, {"canal_pesquisa", type text}}, "en-US"),
				    Classe = Table.AddColumn(Tipado, "Classe NPS", each if [nps_score] >= 9 then "Promotor" else if [nps_score] >= 7 then "Neutro" else "Detrator", type text),
				    Ordem = Table.AddColumn(Classe, "Ordem Classe NPS", each if [nps_score] >= 9 then 1 else if [nps_score] >= 7 then 2 else 3, Int64.Type),
				    Ultimo = Ordem,
				    Final = Table.SelectColumns(Ultimo, {"id_pesquisa", "id_cliente", "id_venda", "data_pesquisa", "canal", "id_loja", "nps_score", "csat_score", "id_motivo_principal", "canal_pesquisa", "Classe NPS", "Ordem Classe NPS"})
				in
				    Final

	annotation PBI_ResultType = Table
